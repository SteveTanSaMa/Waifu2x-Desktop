    "%d 张图片未能导入；其余图片已加入列表。\n\n%@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not import %d images; the remaining images were added to the queue.\n\n%@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%d 张图片未能导入；其余图片已加入列表。\n\n%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有 %d 張圖片無法匯入；其餘圖片已加入列表\n\n%@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%d枚の画像を読み込めませんでした；残りの画像はリストに追加しました\n\n%@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échecs d’importation : %d ; les autres images ont été ajoutées à la file\n\n%@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가져오지 못한 이미지: %d; 나머지 이미지는 목록에 추가되었습니다\n\n%@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось импортировать: %d; остальные изображения добавлены в очередь\n\n%@"
          }
        }
      }
